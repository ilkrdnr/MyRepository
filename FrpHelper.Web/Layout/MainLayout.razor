@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (ShowWorkspaceChrome)
{
    <div class="app-shell">
        <aside class="sidebar">
            <NavMenu />
        </aside>

        <main class="main">
            <header class="topbar">
                <h1>FRP Helper</h1>
                <p>FastReport XML analiz, düzenleme ve Supabase havuz senkronu</p>
            </header>

            <article class="content">
                @Body
            </article>
        </main>
    </div>
}
else
{
    <main class="guest-main">
        @Body
    </main>
}

@code {
    private bool _isAuthenticated;
    private bool _hashRouteChecked;

    private bool ShowWorkspaceChrome => _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        AuthService.SessionChanged += HandleSessionChanged;

        var session = await AuthService.RestoreSessionAsync();
        _isAuthenticated = session?.IsAuthenticated == true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hashRouteChecked)
        {
            return;
        }

        _hashRouteChecked = true;

        var route = await JS.InvokeAsync<string>("frpRouting.takeHashRoute");
        if (string.IsNullOrWhiteSpace(route) || !route.StartsWith('/'))
        {
            return;
        }

        Navigation.NavigateTo(route, replace: true);
    }

    private void HandleSessionChanged(AuthSession? session)
    {
        _isAuthenticated = session?.IsAuthenticated == true;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.SessionChanged -= HandleSessionChanged;
    }
}
